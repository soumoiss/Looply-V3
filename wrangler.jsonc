{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "looply-v3-staging",
  "main": "./backend/cloudflare/worker.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/neon-health",
      "/api/*"
    ]
  }
}
